# Factur-E staging autoporté — variables d'environnement (template NON-SENSIBLE).
#
# Copier en `.env.staging.local` (gitignored) puis renseigner les secrets
# sensibles ci-dessous. `./init.sh` fait la copie automatiquement si absent.
#
# ⚠️ ADR-008 : NE JAMAIS committer de valeur secrète réelle dans ce fichier.
#    Les secrets vivent uniquement dans `.env.staging.local` (jamais versionné).

# ─────────────────────────────────────────────────────────────────────────
# Secrets SENSIBLES — à renseigner manuellement (laissés VIDES dans l'exemple)
# ─────────────────────────────────────────────────────────────────────────

# SuperPDP sandbox — OBLIGATOIRES (depuis ton enregistrement d'app SuperPDP).
# Sans eux, la connexion OAuth d'un compte échoue → pas d'émission/réception.
# Cf. README §3.2 (obtention des credentials sandbox).
SUPERPDP_CLIENT_ID=
SUPERPDP_CLIENT_SECRET=

# JWT_SIGNING_KEY (>= 32 caractères) + ENCRYPTION_KEY_HEX (64 hex = 32 octets).
# Clés LOCALES propres à ton instance — laisse VIDE : `./init.sh` les génère
# automatiquement (openssl rand) et les écrit dans `.env.staging.local`.
JWT_SIGNING_KEY=
ENCRYPTION_KEY_HEX=

# INSEE — OPTIONNEL : les SIREN sandbox (Tricatel/Burger Queen) sont pré-seedés
# en cache, donc aucun appel INSEE réel n'est requis pour les comptes de test.
INSEE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Configuration NON-SENSIBLE (valeurs par défaut prêtes à l'emploi)
# ─────────────────────────────────────────────────────────────────────────

# SuperPDP sandbox — endpoint public (override si ton sandbox diffère).
SUPERPDP_BASE_URL=https://api.superpdp.tech

# Callback OAuth — DOIT être enregistré à l'identique côté SuperPDP sandbox.
# (Même origine que le SPA = port web ci-dessous, proxy nginx ADR-014.)
SUPERPDP_REDIRECT_URI=http://localhost:47280/oauth/superpdp/callback

# Adapters (cf. docker-compose.yml — ne pas passer en production) :
#   - mock   : emails capturés en RAM, relus via /__dev/last-email (pas de TEM)
#   - memory : secret store en mémoire (pas de Keychain macOS)
EMAIL_ADAPTER=mock
SECRETS_ADAPTER=memory
NODE_ENV=development

# Cycle de vie PA (ADR-002 D2 — polling-only, pas de webhook).
WEBHOOK_ENABLED=false
POLLING_INTERVAL_SEC=900
# Cadence réelle des polls (cron). Défaut 1 min = retour rapide en test ;
# passe à "*/15 * * * *" pour un comportement type prod (15 min).
RECV_POLLING_CRON=* * * * *
CDAR_POLLING_CRON=* * * * *

# Postgres / MinIO (réseau interne compose — credentials de DEV, non sensibles).
POSTGRES_DB=factur_e_staging
POSTGRES_USER=factur_e_staging
POSTGRES_PASSWORD=factur_e_staging_password
MINIO_ROOT_USER=factur_e_staging
MINIO_ROOT_PASSWORD=factur_e_staging_password

# Ports hôte (bloc 472xx — faible risque de collision avec les outils usuels).
# Ajuste si l'un d'eux est déjà pris sur ton poste (cf. README §5 Troubleshooting).
# SPA + proxy same-origin (point d'entrée navigateur)
STAGING_WEB_PORT=47280
# API directe (curl /health + /__dev/last-email)
STAGING_API_PORT=47281
# microservice OCR
STAGING_OCR_PORT=47282
# Postgres
STAGING_POSTGRES_PORT=47254
# MinIO S3 API
STAGING_MINIO_PORT=47290
# MinIO console web
STAGING_MINIO_CONSOLE_PORT=47291
